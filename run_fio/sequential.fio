# Latency experiment, sequential 128 KiB requests, 4 tenants (t1 writes, t2-t4 read).
# Run the sections in three steps; see run_fio/README.md.
# Set NVMEV_MNT to the directory that holds the four tenant mount points p1..p4.
[global]
ioengine=libaio
direct=1
norandommap=1
randrepeat=1
nrfiles=1
cpus_allowed=0,1,2,8,9,10
cpus_allowed_policy=split
percentile_list=50:75:90:95:99:99.9:99.99

[prefill_t1]
directory=${NVMEV_MNT}/p1
filename=t.dat
rw=write
bs=1M
size=22272M
iodepth=32

[prefill_t2]
directory=${NVMEV_MNT}/p2
filename=t.dat
rw=write
bs=1M
size=22272M
iodepth=32

[prefill_t3]
directory=${NVMEV_MNT}/p3
filename=t.dat
rw=write
bs=1M
size=22272M
iodepth=32

[prefill_t4]
directory=${NVMEV_MNT}/p4
filename=t.dat
rw=write
bs=1M
size=22272M
iodepth=32

[t1]
directory=${NVMEV_MNT}/p1
filename=t.dat
rw=randrw
rwmixread=0
percentage_random=0,0
bs=128k,128k
blockalign=4k
size=22272M
iodepth=32
rate_iops=,1800
random_distribution=zipf:0
write_lat_log=results_${TS}/lat
log_avg_msec=0
time_based=1
runtime=200
ramp_time=0

[t2]
directory=${NVMEV_MNT}/p2
filename=t.dat
rw=randrw
rwmixread=100
percentage_random=0,0
bs=128k,128k
blockalign=4k
size=22272M
iodepth=32
rate_iops=5333
random_distribution=zipf:0
write_lat_log=results_${TS}/lat
log_avg_msec=0
time_based=1
runtime=200
ramp_time=0

[t3]
directory=${NVMEV_MNT}/p3
filename=t.dat
rw=randrw
rwmixread=100
percentage_random=0,0
bs=128k,128k
blockalign=4k
size=22272M
iodepth=32
rate_iops=5333
random_distribution=zipf:0
write_lat_log=results_${TS}/lat
log_avg_msec=0
time_based=1
runtime=200
ramp_time=0

[t4]
directory=${NVMEV_MNT}/p4
filename=t.dat
rw=randrw
rwmixread=100
percentage_random=0,0
bs=128k,128k
blockalign=4k
size=22272M
iodepth=32
rate_iops=5333
random_distribution=zipf:0
write_lat_log=results_${TS}/lat
log_avg_msec=0
time_based=1
runtime=200
ramp_time=0
