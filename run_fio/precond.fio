# Preconditioning: 100 GiB of zipf(1.2) random 64 KiB writes over the four tenant files.
# Set NVMEV_MNT as for the workload files.
[global]
ioengine=libaio
direct=1
norandommap=1
randrepeat=1
nrfiles=1
cpus_allowed=0,1,2,8,9,10
cpus_allowed_policy=split
percentile_list=50:75:90:95:99:99.9:99.99

[pc_t1]
directory=${NVMEV_MNT}/p1
filename=t.dat
rw=randwrite
bs=64k
size=22272M
io_size=25600M
random_distribution=zipf:1.2
iodepth=32

[pc_t2]
directory=${NVMEV_MNT}/p2
filename=t.dat
rw=randwrite
bs=64k
size=22272M
io_size=25600M
random_distribution=zipf:1.2
iodepth=32

[pc_t3]
directory=${NVMEV_MNT}/p3
filename=t.dat
rw=randwrite
bs=64k
size=22272M
io_size=25600M
random_distribution=zipf:1.2
iodepth=32

[pc_t4]
directory=${NVMEV_MNT}/p4
filename=t.dat
rw=randwrite
bs=64k
size=22272M
io_size=25600M
random_distribution=zipf:1.2
iodepth=32
